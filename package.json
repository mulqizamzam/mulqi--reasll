{
  "name": "mulqi-reasll",
  "version": "1.0.1",
  "description": "Mulqi ReaSLL — DSH skill plugin for reverse engineering with a self-learning loop: examine a product you are authorised to rebuild, build your own equivalent, review it against evidence, close the gaps, and repeat until a written 100% checklist passes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./assets/*": "./assets/*",
    "./vendor/upstream/*": "./vendor/upstream/*",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "assets/",
    "vendor/upstream/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "HOWTOUSE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Speedrun AI Labs (original skill); mulqizamzam (DSH port)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "reverse-engineering",
    "reconstruction",
    "learning-loop",
    "mulqi-reasll"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulqizamzam/mulqi--reasll.git"
  },
  "homepage": "https://github.com/mulqizamzam/mulqi--reasll#readme",
  "bugs": {
    "url": "https://github.com/mulqizamzam/mulqi--reasll/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/validate.mjs && node --test tests/*.test.js"
  }
}